CREATE CONSTRAINT ontology_iri IF NOT EXISTS FOR (n:OntologyTerm) REQUIRE n.iri IS UNIQUE;
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/core#Area'}) SET n.name = 'Area', n.module = 'core', n.definition = 'A part of a site organized around one kind of work.', n.examples = ['packaging, utilities, warehouse'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/core#Asset'}) SET n.name = 'Asset', n.module = 'core', n.definition = 'Anything in the equipment hierarchy that has a stable identity.', n.examples = ['a site, a packaging line, a filler, a seal kit'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/core#Capability'}) SET n.name = 'Capability', n.module = 'core', n.definition = 'Something an equipment is able to do, stated independently of any product or order. Matching what a product requires with what a line offers answers where the product can run.', n.examples = ['fill 500 ml PET bottles, apply 28 mm caps, wrap-around labelling'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/core#DataPoint'}) SET n.name = 'DataPoint', n.module = 'core', n.definition = 'A measured or derived value that belongs to an asset: a PLC tag, a sensor reading, a computed KPI.', n.examples = ['the speed of filler-01, the state of capper-01'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/core#Enterprise'}) SET n.name = 'Enterprise', n.module = 'core', n.definition = 'The company as a whole, the root of the hierarchy.', n.examples = ['ACME Beverages'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/core#Equipment'}) SET n.name = 'Equipment', n.module = 'core', n.definition = 'ISA-95 work cell or unit: one machine that runs, stops and produces.', n.examples = ['filler-01 of line 1'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/core#EquipmentClass'}) SET n.name = 'EquipmentClass', n.module = 'core', n.definition = 'A catalogue entry for a kind of equipment. It describes the type, while Equipment is one installed machine of that type.', n.examples = ['filler, capper, labeler'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/core#Event'}) SET n.name = 'Event', n.module = 'core', n.definition = 'Something that happened to an asset over a period of time. Every domain event inherits where and when from here, which is what lets them be crossed.', n.examples = ['a production run, a stop, an inspection, a maintenance order'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/core#Line'}) SET n.name = 'Line', n.module = 'core', n.definition = 'A set of equipment arranged to make product in sequence. Orders are scheduled on lines.', n.examples = ['Line 1: filler, capper and labeler'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/core#OperatingState'}) SET n.name = 'OperatingState', n.module = 'core', n.definition = 'One of the harmonized states every equipment reports, whatever its vendor calls them. The label is the exact text published in the UNS.', n.examples = ['RUNNING, IDLE, STOPPED, FAULTED'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/core#Person'}) SET n.name = 'Person', n.module = 'core', n.definition = 'Someone who performs or is accountable for work in the plant.', n.examples = ['a maintenance technician, a quality inspector'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/core#Role'}) SET n.name = 'Role', n.module = 'core', n.definition = 'A function a person performs. Kept apart from the person because people change roles and one role is held by many people.', n.examples = ['maintenance technician, quality inspector, line operator'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/core#Site'}) SET n.name = 'Site', n.module = 'core', n.definition = 'A plant at one geographic location.', n.examples = ['São Paulo plant, Curitiba plant'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/core#StateChange'}) SET n.name = 'StateChange', n.module = 'core', n.definition = 'The moment an equipment moved from one operating state to another.', n.examples = ['filler-01 went from RUNNING to FAULTED at 09:00'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/energy#Consumption'}) SET n.name = 'Consumption', n.module = 'energy', n.definition = 'The energy a meter recorded between two instants.', n.examples = ['612 kWh on line 1 during the morning shift'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/energy#EnergyBaseline'}) SET n.name = 'EnergyBaseline', n.module = 'energy', n.definition = 'The energy a product is expected to take per thousand good units, with the tolerance before it counts as a deviation.', n.examples = ['still water 500 ml: 3.5 kWh per 1,000 bottles, tolerance 15 %'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/energy#EnergyCarrier'}) SET n.name = 'EnergyCarrier', n.module = 'energy', n.definition = 'The form in which energy reaches the equipment.', n.examples = ['electricity, compressed air, steam'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/energy#EnergyMeter'}) SET n.name = 'EnergyMeter', n.module = 'energy', n.definition = 'A data point that accumulates the energy used by an asset.', n.examples = ['the electricity meter of line 1'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/inventory#Material'}) SET n.name = 'Material', n.module = 'inventory', n.definition = 'A raw or packaging material, as an item in the catalogue.', n.examples = ['cap 28 mm, PET preform, label'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/inventory#MaterialLot'}) SET n.name = 'MaterialLot', n.module = 'inventory', n.definition = 'One delivery of a material from one supplier, traceable as a unit.', n.examples = ['ML-2207: caps 28 mm delivered by Cap Co'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/inventory#StockItem'}) SET n.name = 'StockItem', n.module = 'inventory', n.definition = 'The quantity of one material lot that sits in one storage location right now.', n.examples = ['12,000 caps of lot ML-2207 in rack A-03'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/inventory#StorageLocation'}) SET n.name = 'StorageLocation', n.module = 'inventory', n.definition = 'A place where material is kept, in a warehouse or at the line.', n.examples = ['warehouse rack A-03, point of use at line 1'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/inventory#Supplier'}) SET n.name = 'Supplier', n.module = 'inventory', n.definition = 'A company that delivers material.', n.examples = ['Cap Co, Seal Systems'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/maintenance#Component'}) SET n.name = 'Component', n.module = 'maintenance', n.definition = 'A replaceable part of an equipment that maintenance tracks on its own.', n.examples = ['seal kit, main motor, valve block'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/maintenance#CorrectiveOrder'}) SET n.name = 'CorrectiveOrder', n.module = 'maintenance', n.definition = 'Maintenance done because something failed.', n.examples = ['MO-0077: replace the seal kit after repeated stops'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/maintenance#Downtime'}) SET n.name = 'Downtime', n.module = 'maintenance', n.definition = 'An interval in which equipment did not run when it was scheduled to.', n.examples = ['filler-01 stopped 15 minutes for seal wear'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/maintenance#FailureMode'}) SET n.name = 'FailureMode', n.module = 'maintenance', n.definition = 'The way something fails. A shared vocabulary instead of free text, so stops can be counted and compared.', n.examples = ['seal wear, bottle jam, motor overload'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/maintenance#MaintenanceOrder'}) SET n.name = 'MaintenanceOrder', n.module = 'maintenance', n.definition = 'A piece of maintenance work carried out on an asset.', n.examples = ['a repair after a failure, a scheduled seal replacement'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/maintenance#MaintenancePlan'}) SET n.name = 'MaintenancePlan', n.module = 'maintenance', n.definition = 'A recurring preventive task for a component, with its interval and next due date.', n.examples = ['replace the filler seal kit every 30 days'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/maintenance#PreventiveOrder'}) SET n.name = 'PreventiveOrder', n.module = 'maintenance', n.definition = 'Maintenance done on schedule, before a failure.', n.examples = ['MO-0061: scheduled inspection of the main motor'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/maintenance#SparePart'}) SET n.name = 'SparePart', n.module = 'maintenance', n.definition = 'A stocked replacement for a component. It is held and fitted, not operated.', n.examples = ['seal kit SK-28 for the line 1 filler'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/production#Changeover'}) SET n.name = 'Changeover', n.module = 'production', n.definition = 'The planned time spent switching a line from one product or format to another.', n.examples = ['line 3 switching from 500 ml to 1 l bottles'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/production#Lot'}) SET n.name = 'Lot', n.module = 'production', n.definition = 'The traceable quantity of product made in one run. Quality decisions and recalls are taken per lot.', n.examples = ['L-1042'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/production#Product'}) SET n.name = 'Product', n.module = 'production', n.definition = 'A sellable item, identified by its SKU.', n.examples = ['still water 500 ml, orange juice 1 l'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/production#ProductionRun'}) SET n.name = 'ProductionRun', n.module = 'production', n.definition = 'The execution of a work order on equipment between a start and an end time.', n.examples = ['R-1042 on filler-01 of line 1, 08:00 to 10:00'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/production#Shift'}) SET n.name = 'Shift', n.module = 'production', n.definition = 'A scheduled working period of a site. KPIs are usually reported per shift.', n.examples = ['morning shift, 06:00 to 14:00'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/production#WorkOrder'}) SET n.name = 'WorkOrder', n.module = 'production', n.definition = 'A request to produce a quantity of one product.', n.examples = ['WO-1042: 46,000 bottles of still water 500 ml'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/quality#Characteristic'}) SET n.name = 'Characteristic', n.module = 'quality', n.definition = 'A measurable property of the product that quality controls.', n.examples = ['cap removal torque, fill volume'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/quality#DefectType'}) SET n.name = 'DefectType', n.module = 'quality', n.definition = 'A named kind of defect, counted the same way everywhere.', n.examples = ['leak at cap, label skewed'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/quality#Finding'}) SET n.name = 'Finding', n.module = 'quality', n.definition = 'One defect type found in one inspection, with how many units showed it.', n.examples = ['37 leaks at cap in inspection Q-1042'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/quality#Inspection'}) SET n.name = 'Inspection', n.module = 'quality', n.definition = 'A quality check carried out on a lot, ending in a decision.', n.examples = ['Q-1042: inspection of lot L-1042, result HOLD'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/quality#Measurement'}) SET n.name = 'Measurement', n.module = 'quality', n.definition = 'One measured value of a characteristic, taken during an inspection.', n.examples = ['1.31 N·m on a sample of lot L-1043'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/quality#NonConformance'}) SET n.name = 'NonConformance', n.module = 'quality', n.definition = 'A formal record that a lot does not meet requirements, with what was decided about it.', n.examples = ['NC-002: lot L-1043 rejected for leaks, to be scrapped'];
MERGE (n:OntologyTerm:OntologyClass {iri: 'https://w3id.org/industrial-ontology-lab/quality#Specification'}) SET n.name = 'Specification', n.module = 'quality', n.definition = 'The accepted range of one characteristic for one product.', n.examples = ['cap removal torque of still water 500 ml: 1.4 to 2.0 N·m'];
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/core#canTransitionTo'}) SET n.name = 'canTransitionTo', n.module = 'core', n.definition = 'A state change that is physically and procedurally possible. A reported change that is not listed here signals a data or integration problem.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/core#fromOperatingState'}) SET n.name = 'fromOperatingState', n.module = 'core', n.definition = 'The harmonized state the equipment was in before the change.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/core#hasCapability'}) SET n.name = 'hasCapability', n.module = 'core', n.definition = 'What this equipment is able to do in its current configuration.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/core#hasDataPoint'}) SET n.name = 'hasDataPoint', n.module = 'core', n.definition = 'The values available for this asset.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/core#hasPart'}) SET n.name = 'hasPart', n.module = 'core', n.definition = 'Inverse of partOf: the assets directly contained in this one.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/core#hasRole'}) SET n.name = 'hasRole', n.module = 'core', n.definition = 'The function this person performs.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/core#occurredOn'}) SET n.name = 'occurredOn', n.module = 'core', n.definition = 'The asset the event happened to.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/core#ofClass'}) SET n.name = 'ofClass', n.module = 'core', n.definition = 'The kind of equipment this machine is.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/core#partOf'}) SET n.name = 'partOf', n.module = 'core', n.definition = 'Containment in the equipment hierarchy. Transitive: a filler partOf line 1 partOf area partOf site.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/core#performedBy'}) SET n.name = 'performedBy', n.module = 'core', n.definition = 'Who carried out the event.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/core#toOperatingState'}) SET n.name = 'toOperatingState', n.module = 'core', n.definition = 'The harmonized state the equipment entered.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/energy#baselineFor'}) SET n.name = 'baselineFor', n.module = 'energy', n.definition = 'The product an energy baseline applies to.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/energy#carrier'}) SET n.name = 'carrier', n.module = 'energy', n.definition = 'The energy carrier a meter measures.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/energy#measuredBy'}) SET n.name = 'measuredBy', n.module = 'energy', n.definition = 'The meter that recorded a consumption interval.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/energy#meters'}) SET n.name = 'meters', n.module = 'energy', n.definition = 'The asset a meter measures. A meter on a line measures all of its equipment.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/inventory#consumed'}) SET n.name = 'consumed', n.module = 'inventory', n.definition = 'Genealogy link: the material lots that went into a run.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/inventory#locatedIn'}) SET n.name = 'locatedIn', n.module = 'inventory', n.definition = 'The asset, usually a site or a line, where a storage location is.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/inventory#materialOf'}) SET n.name = 'materialOf', n.module = 'inventory', n.definition = 'The catalogue material a lot is made of.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/inventory#stockOf'}) SET n.name = 'stockOf', n.module = 'inventory', n.definition = 'The material lot a stock item holds.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/inventory#storedAt'}) SET n.name = 'storedAt', n.module = 'inventory', n.definition = 'Where a stock item sits.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/inventory#suppliedBy'}) SET n.name = 'suppliedBy', n.module = 'inventory', n.definition = 'The supplier that delivered a material lot.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/maintenance#affects'}) SET n.name = 'affects', n.module = 'maintenance', n.definition = 'The component a failure mode damages or depends on.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/maintenance#causedBy'}) SET n.name = 'causedBy', n.module = 'maintenance', n.definition = 'The failure mode behind a stop.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/maintenance#covers'}) SET n.name = 'covers', n.module = 'maintenance', n.definition = 'The component a maintenance plan keeps in condition.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/maintenance#fits'}) SET n.name = 'fits', n.module = 'maintenance', n.definition = 'The component a spare part can replace.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/maintenance#replaced'}) SET n.name = 'replaced', n.module = 'maintenance', n.definition = 'The component exchanged during the order.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/maintenance#resolves'}) SET n.name = 'resolves', n.module = 'maintenance', n.definition = 'The stop a maintenance order was raised to fix.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/maintenance#usedSpare'}) SET n.name = 'usedSpare', n.module = 'maintenance', n.definition = 'The spare part consumed by the order.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/production#executes'}) SET n.name = 'executes', n.module = 'production', n.definition = 'The work order a run is fulfilling.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/production#forProduct'}) SET n.name = 'forProduct', n.module = 'production', n.definition = 'The product a work order asks for.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/production#lotOf'}) SET n.name = 'lotOf', n.module = 'production', n.definition = 'The product a lot contains.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/production#produced'}) SET n.name = 'produced', n.module = 'production', n.definition = 'The lot that came out of a run.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/production#requiresCapability'}) SET n.name = 'requiresCapability', n.module = 'production', n.definition = 'What equipment must be able to do for this product to be made. A line can run the product when its equipment covers every required capability.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/production#toProduct'}) SET n.name = 'toProduct', n.module = 'production', n.definition = 'The product a changeover prepares the line for.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/quality#concerns'}) SET n.name = 'concerns', n.module = 'quality', n.definition = 'The lot a non-conformance is about.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/quality#defectType'}) SET n.name = 'defectType', n.module = 'quality', n.definition = 'Which kind of defect a finding counts.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/quality#hasFinding'}) SET n.name = 'hasFinding', n.module = 'quality', n.definition = 'The defects an inspection counted.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/quality#hasMeasurement'}) SET n.name = 'hasMeasurement', n.module = 'quality', n.definition = 'The values measured during an inspection.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/quality#inspects'}) SET n.name = 'inspects', n.module = 'quality', n.definition = 'The lot an inspection examined.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/quality#ofCharacteristic'}) SET n.name = 'ofCharacteristic', n.module = 'quality', n.definition = 'The characteristic a measurement or a specification refers to.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/quality#raisedBy'}) SET n.name = 'raisedBy', n.module = 'quality', n.definition = 'The inspection that opened the non-conformance.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/quality#specFor'}) SET n.name = 'specFor', n.module = 'quality', n.definition = 'The product a specification applies to.', n.kind = 'relation';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/core#assetId'}) SET n.name = 'assetId', n.module = 'core', n.definition = 'Stable business identifier, the same in UNS, MES and CMMS.', n.kind = 'attribute';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/core#endTime'}) SET n.name = 'endTime', n.module = 'core', n.definition = 'When the event ended. Absent while the event is still open.', n.kind = 'attribute';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/core#isProductive'}) SET n.name = 'isProductive', n.module = 'core', n.definition = 'True when time in this state counts as running time for availability.', n.kind = 'attribute';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/core#lastUpdate'}) SET n.name = 'lastUpdate', n.module = 'core', n.definition = 'When lastValue was received.', n.kind = 'attribute';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/core#lastValue'}) SET n.name = 'lastValue', n.module = 'core', n.definition = 'Most recent value received from the UNS. Written by the bridge, never by hand.', n.kind = 'attribute';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/core#startTime'}) SET n.name = 'startTime', n.module = 'core', n.definition = 'When the event began.', n.kind = 'attribute';
MERGE (n:OntologyTerm:OntologyProperty {iri: 'https://w3id.org/industrial-ontology-lab/core#toState'}) SET n.name = 'toState', n.module = 'core', n.definition = 'The state text exactly as received, kept even when it matches no known operating state.', n.kind = 'attribute';
